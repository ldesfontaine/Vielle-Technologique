# Redis Upstash (obligatoire pour la persistence)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port de l'API HTTP (optionnel, défaut: 3000)
PORT=3000

# Seuil de score pour isUrgent (optionnel, défaut: 70)
URGENT_SCORE_THRESHOLD=70

# ─── Phase 2 : Clés API optionnelles ──────────────────────────────────────────
# Les sources gratuites (CISA KEV, EPSS, CVE.org, OSV.dev, MITRE ATT&CK)
# fonctionnent SANS clé API. Les sources ci-dessous sont optionnelles :
# si la clé est absente, la source est simplement ignorée (graceful skip).

# AlienVault OTX — IOCs communautaires (gratuit, inscription requise)
# https://otx.alienvault.com/api
OTX_API_KEY=

# AbuseIPDB — Blacklist d'IPs malveillantes (gratuit jusqu'à 1000 req/jour)
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# VirusTotal — Threat actors et détections (gratuit, 4 req/min)
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan — Vulnérabilités exposées (pas encore intégré)
SHODAN_API_KEY=

# GreyNoise Community — Classification des IPs (gratuit, 50 req/jour)
# https://viz.greynoise.io/account/api-key
# Note : fonctionne sans clé en mode Community (enrichissement limité)
GREYNOISE_API_KEY=

