# Redis Upstash (obligatoire pour la persistence)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port de l'API HTTP (optionnel, défaut: 3000)
PORT=3000

# Seuil de score pour isUrgent (optionnel, défaut: 70)
URGENT_SCORE_THRESHOLD=70

# Clés API optionnelles pour enrichissement
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
