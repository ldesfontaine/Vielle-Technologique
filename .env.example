# Stack surveille (noms de tools separes par des virgules)
WATCH_STACK=traefik,seafile,vaultwarden,docker,linux,netbird,crowdsec

# Ntfy (notifications)
NTFY_URL=https://ntfy.ton-domaine.com
NTFY_TOPIC=veille-secu
NTFY_TOKEN=

# Scheduler
CRON_INTERVAL=3600

# SQLite
DB_PATH=/data/veille.db

# API HTTP
WEB_PORT=8094

# Dashboard (optionnel)
DASHBOARD_ENABLED=false

# Collect manuel (cooldown en secondes)
MANUAL_COLLECT_COOLDOWN=900

# Auth API (Bearer token pour les endpoints mutants POST/PATCH/DELETE)
VEILLE_TOKEN=

# GitHub Advisories (optionnel, augmente le quota API)
GITHUB_TOKEN=

